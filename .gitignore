# Données de travail suivies avec Git LFS
# (voir .gitattributes)

# Environnements et caches Python
.venv/
venv/
__pycache__/
.pytest_cache/
**/pytest-cache-files-*/
*.py[cod]

# Logs et fichiers générés
*.log
*.tsbuildinfo
coverage/

# Fichiers dérivés reconstruits par preparer.bat : les versionner doublerait le
# poids du dépôt sans rien apporter, puisqu'ils se régénèrent depuis les cubes
# sources en quelques minutes.
data/cube_damir_compact.parquet
data/cube_reglement.parquet
data/.cache/

# Chantier de reconstruction du cube (tools/build_cube_damir.py) : parts
# intermédiaires et cubes candidats. Le .gitattributes envoie tout *.parquet
# vers Git LFS — sans ces lignes, 2,4 Go de parts partiraient au dépôt.
data/.cube_parts_v2/
data/cube_damir_v2.parquet
data/cube_damir_compact_v2.parquet

# Le cube reconstruit le 23/09/2026 ne passe pas par le dépôt : il se transfère
# à la main. `data/cube_damir.parquet` reste versionné dans son état d'origine,
# et ses modifications locales sont masquées par
#     git update-index --skip-worktree data/cube_damir.parquet
# (une règle .gitignore serait sans effet sur un fichier déjà suivi).
# Pour revoir ces modifications un jour : --no-skip-worktree.

# Sources brutes CSP : elles servent à reconstruire les données, mais ne sont
# pas nécessaires pour exécuter DAMIR (les fichiers csp_core*.parquet le sont).
data/csp/raw/
data/csp/Années/
data/csp/RP20*_INDREG_*.zip
data/csp/RP20*_indreg.parquet

# Frontend
node_modules/
dist/

# Configuration locale de l'agent (permissions, historique de session) :
# spécifique à la machine, ne doit pas être partagée entre postes.
.claude/

# Originaux Word des documents de mission : le Markdown de `docs/` fait foi et
# se lit dans un diff, ces binaires ne s'y prêtent pas. Ils restent sur le poste
# dans `docs/sources/` sans encombrer l'historique.
docs/sources/*.docx

# Fichiers locaux et secrets
.env
.env.*
!.env.example

# Tranches annuelles de flux (1,5 Go), source locale optionnelle de tools/etude_roc_hospitalisation.py
cube_parts3/

# Dossiers de travail des agents et versions intermédiaires du diapo
.tmp_roc_v*/
old_ppt/

# Sauvegarde de l' ancien cube, gardee le temps de valider le nouveau.
data/cube_damir_ancien.parquet
